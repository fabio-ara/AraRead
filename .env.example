# Local: copie para .env. Nunca reutilize credenciais dos projetos irmãos.
APP_MODE=local
APP_NAME=AraRead
APP_ORIGIN=http://127.0.0.1:4317
PORT=4317
AUTH_URL=http://127.0.0.1:4318
AUTH_ISSUER=http://127.0.0.1:4317/auth/v1
AUTH_AUDIENCE=authenticated
MCP_AUDIENCE=http://127.0.0.1:4317/mcp
DATABASE_URL=postgres://araread_app:araread-local-only@127.0.0.1:56432/araread
# npm run local:setup acrescenta LOCAL_JWT_KEYS localmente; não copiar para produção.
# Hospedado: APP_MODE=production, URLs HTTPS do projeto exclusivo e credenciais via secret manager.
