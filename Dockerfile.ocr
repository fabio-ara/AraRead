FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 poppler-utils tesseract-ocr tesseract-ocr-por tesseract-ocr-eng && rm -rf /var/lib/apt/lists/*
COPY scripts/ocr-pdf.py /app/ocr-pdf.py
ENV OMP_THREAD_LIMIT=1
USER 65534:65534
ENTRYPOINT ["python3", "/app/ocr-pdf.py"]
